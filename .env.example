# Base URL of the backend API.
# Set this for live data (MSW stays off), e.g.:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
# Leave empty to use relative paths (MSW mocks the API in the browser).
NEXT_PUBLIC_API_URL=

# Landing-page “Book a demo” link (Calendly, HubSpot, etc.).
# If unset, the page falls back to mailto:sales@tgs.com
# NEXT_PUBLIC_DEMO_URL=https://calendly.com/your-team/caller-crm-demo
NEXT_PUBLIC_DEMO_URL=
